    "pole_pairs":         { "v": 10,      "u": "-",   "s": "ASSUMPTION", "n": "Axial-flux marine machines commonly 8-14. Sets electrical frequency." },
    "Ld_H":               { "v": 85e-6,   "u": "H",   "s": "ASSUMPTION" },
    "Lq_H":               { "v": 95e-6,   "u": "H",   "s": "ASSUMPTION", "n": "Slight saliency assumed." },
    "rated_phase_current_peak_A": { "v": 400, "u": "A", "s": "ASSUMPTION", "n": "Sets the flux-linkage back-calculation." },
    "peak_efficiency":    { "v": 0.955,   "u": "-",   "s": "ASSUMPTION",
      "n": "Phase resistance is BACK-SOLVED from this so the loss model reproduces it. Assuming a resistance and separately declaring an efficiency is how a model ends up reporting 89% while claiming 95.5%." },

    "iron_loss_k1_W_per_Hz":  { "v": 0.85,   "u": "W/Hz",   "s": "ASSUMPTION", "n": "Hysteresis, linear in electrical frequency." },
    "iron_loss_k2_W_per_Hz2": { "v": 1.2e-3, "u": "W/Hz^2", "s": "ASSUMPTION", "n": "Eddy current, quadratic." },
    "windage_k_W_per_rpm3":   { "v": 2.5e-10,"u": "W/rpm^3","s": "ASSUMPTION" },
    "mech_loss_const_W":      { "v": 60,     "u": "W",      "s": "ASSUMPTION", "n": "Bearing drag and seal friction." },
    "cu_tempco_per_K":        { "v": 0.00393,"u": "1/K",    "s": "PUBLISHED_TEST" },
    "winding_temp_calib_C":   { "v": 100,    "u": "degC",   "s": "ASSUMPTION", "n": "Temperature at which the loss model is evaluated." },

