  "cooling": {
    "_architecture": [
      "END (AXIAL) COOLING VIA COLD PLATES - not side cooling.",
      "",
      "WHY. In the flat 26x21 layout the coolant tubes sat in the inter-row",
      "gaps. That cannot be done here. In the two-layer pack the gap between",
      "cell rows INSIDE a group is 2.0 mm, and a 6 mm tube does not fit. Only",
      "the 12 mm inter-group gaps could take a tube, and those reach just the",
      "outer row of each 3-row group - leaving the centre row of all 26 groups",
      "with no adjacent tube. That is the orphaned-row failure mode from the",
      "flat study, but affecting a third of the pack instead of one row.",
      "",
      "The geometry instead offers something better. Cylindrical cells conduct",
      "roughly 30x better along the winding axis (25 W/m.K) than across it",
      "(0.85 W/m.K), and the two-layer stack already has three natural plate",
      "planes: below layer 1, between the layers, and above layer 2. Cooling",
      "the cell ENDS uses the good conduction path and reaches every cell",
      "equally - no orphans possible.",
      "",
      "Layer 1 is cooled at both ends by the base plate and the interlayer",
      "plate. Layer 2 likewise by the interlayer and lid plates. The interlayer",
      "plate serves both, so it carries twice the duty.",
      "",
      "EVERYTHING ELSE FROM THE FLAT MODEL IS RETAINED: serpentine tubes",
      "grouped into parallel hydraulic circuits, Reynolds/Nusselt regime",
      "detection, Dittus-Boelter turbulent h, Darcy-Weisbach pressure drop with",
      "bend losses, coolant advection so the fluid warms along the path, and",
      "counter-flow routing on alternate circuits."
    ],

    "mode":              { "v": "end_plate", "u": "-", "s": "DESIGN_CHOICE", "n": "end_plate or side_tube. See _architecture." },

    "n_plates":          { "v": 3, "u": "-", "s": "CALCULATED", "n": "Base, interlayer, lid." },
    "plate_thickness_m": { "v": 0.0050, "u": "m", "s": "DESIGN_CHOICE" },
    "plate_material_k_W_mK": { "v": 167.0, "u": "W/(m*K)", "s": "PUBLISHED_TEST", "n": "6061-T6 aluminium." },
    "plate_density_kg_m3":   { "v": 2700.0, "u": "kg/m^3", "s": "PUBLISHED_TEST" },
    "plate_cp_J_kgK":        { "v": 896.0,  "u": "J/(kg*K)", "s": "PUBLISHED_TEST" },

    "tubes_per_plate":   { "v": 8, "u": "-", "s": "DESIGN_CHOICE",
      "n": "Serpentine passes across the plate. Sets wetted length and hence velocity for a given flow." },
    "n_circuits":        { "v": 3, "u": "-", "s": "DESIGN_CHOICE",
      "n": "The flat-layout study found a sharp optimum at 3: Re just below the turbulent transition, good h, and 0.24 bar. 2 circuits buys 0.2 K for 3x the pressure; 5 falls off the laminar cliff. Re-verify for this plate geometry." },
    "interleave_circuits": { "v": true, "u": "-", "s": "DESIGN_CHOICE", "n": "Spread each circuit across the pack rather than giving it one region." },
    "counter_flow":      { "v": true, "u": "-", "s": "DESIGN_CHOICE",
      "n": "Reverse alternate circuits. Peak temperature is unchanged - that is set by total heat removal - but spread drops ~16%, and spread drives SOC divergence and differential ageing." },

    "tube_id_m":         { "v": 0.0060, "u": "m", "s": "DESIGN_CHOICE" },
    "n_bends_per_tube":  { "v": 2, "u": "-", "s": "ASSUMPTION", "n": "Serpentine return bends." },
    "K_bend":            { "v": 1.5, "u": "-", "s": "PUBLISHED_TEST", "n": "Minor loss coefficient per 180 degree bend." },

    "flow_L_per_min":    { "v": 8.0,  "u": "L/min", "s": "DESIGN_CHOICE", "n": "Total, split between circuits." },
    "inlet_T_C":         { "v": 28.0, "u": "degC",  "s": "ASSUMPTION",   "n": "After the seawater heat exchanger." },

    "fluid":             { "v": "water_inhibited", "u": "-", "s": "DESIGN_CHOICE",
      "n": "The flat study found 50/50 glycol is ~3x the viscosity of water and drags the flow toward laminar, costing 0.7 K at sustained power. Freeze protection is not a requirement in Monaco in July; corrosion inhibition is, and is bought separately." },
    "rho_kg_m3":         { "v": 997.0,   "u": "kg/m^3",    "s": "PUBLISHED_TEST", "n": "Water at 30 degC." },
    "cp_J_kgK":          { "v": 4180.0,  "u": "J/(kg*K)",  "s": "PUBLISHED_TEST" },
    "mu_Pa_s":           { "v": 0.000797,"u": "Pa*s",      "s": "PUBLISHED_TEST", "n": "Water at 30 degC. 50/50 glycol would be 0.0025." },
    "k_W_mK":            { "v": 0.615,   "u": "W/(m*K)",   "s": "PUBLISHED_TEST", "n": "Water at 30 degC. 50/50 glycol would be 0.38." },

    "R_can_plate_KW":    { "v": 1.20, "u": "K/W", "s": "ASSUMPTION",
      "n": "Cell end face to plate through the thermal interface pad. Cannot be calculated to useful accuracy - bond-line thickness and fill fraction dominate. Measure on an instrumented module." },
    "R_plate_tubewall_KW": { "v": 0.35, "u": "K/W", "s": "ASSUMPTION", "n": "Through the plate to the embedded tube wall." },
    "cell_ends_cooled":  { "v": 2, "u": "-", "s": "CALCULATED", "n": "Both ends of every cell contact a plate in this stack-up." },

    "gap_filler_k_W_mK": { "v": 1.5,  "u": "W/(m*K)", "s": "ASSUMPTION", "n": "Potting compound between cell cans. Air only would be 0.03." },
    "gap_contact_frac":  { "v": 0.16, "u": "-",       "s": "ASSUMPTION", "n": "Effective conduction area fraction between adjacent cans." },

    "allowed_coolant_rise_K": { "v": 5.0, "u": "K", "s": "DESIGN_CHOICE", "n": "Sizing target for flow rate." }
  },

